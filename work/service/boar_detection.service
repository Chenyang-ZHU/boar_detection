[Unit]
Description=Boar Detection HTTP Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/boar-detection
ExecStart=/usr/bin/python3 /opt/boar-detection/app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
